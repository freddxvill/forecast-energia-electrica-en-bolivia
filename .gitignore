# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
# Playwright CLI output (may contain credentials)
.playwright-cli/

# Datos crudos (se regeneran con `uv run poe data`)
data/raw/

# Notebooks / herramientas
.ipynb_checkpoints/
.ruff_cache/
.pytest_cache/
lightning_logs/

# Paquetes armados para Kaggle (se regeneran con kaggle/preparar.py)
kaggle/_build/

# Artefactos derivados (se regeneran en segundos con `poe reporte`, `poe intervalos`
# y `poe jerarquia`). Sí se versionan los backtests por familia: artifacts/backtest/*/.
artifacts/backtest/*.parquet
artifacts/intervalos_*.parquet
artifacts/jerarquia.parquet

# Checkpoints del TFT de producción: viven en la rama `demo-data` (ver .github/scripts/).
artifacts/modelos/

# Plan de trabajo interno (solo local, no se publica).
docs/plan-forecasting.md
